# ==============================================================================
# MEVShield Backend — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named '.env' in this directory:
#      Windows PowerShell: Copy-Item .env.example .env
#      macOS / Linux:      cp .env.example .env
# 2. Modify the values in '.env' as needed for your local environment.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Application Metadata
APP_NAME=MEVShield API
APP_VERSION=1.0.0
APP_DESCRIPTION=Educational MEV analysis and simulation platform for Ethereum

# Runtime Environment
# Allowed values: development, staging, production
ENVIRONMENT=development

# API Route Prefix
API_PREFIX=/api

# Interactive API Documentation
# Set to 'true' to enable Swagger UI (/docs) and ReDoc (/redoc), or 'false' to disable.
DOCS_ENABLED=true

# CORS Configuration — Allowed Frontend Origins
ALLOWED_ORIGINS=http://localhost:5173

# ==============================================================================
# Database Configuration (Backend Phase 2: PostgreSQL)
# ==============================================================================
# Local PostgreSQL or Docker PostgreSQL settings:
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mevshield
DATABASE_USER=mevshield_user
DATABASE_PASSWORD=Leela@2806

# Optional: Provide a full connection string instead of separate components above.
# Example: DATABASE_URL=postgresql+psycopg://mevshield_user:replace_with_local_password@localhost:5432/mevshield
# DATABASE_URL=

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
